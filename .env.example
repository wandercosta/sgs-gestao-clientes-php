# Copie para .env (cp .env.example .env) e ajuste se quiser.
# Os valores abaixo são apenas para desenvolvimento local.

# Conexão da aplicação com o MySQL
DB_HOST=db
DB_PORT=3306
DB_NAME=sgs
DB_USER=sgs_app
DB_PASSWORD=troque-esta-senha

# Usado apenas pelo container do MySQL na primeira inicialização
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# Porta local onde a aplicação fica disponível (http://localhost:8080)
APP_PORT=8080
